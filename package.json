{
	"name": "claude-code-marketplace-manager",
	"version": "1.1.2",
	"private": true,
	"description": "GitHub Action that re-pins git-subdir plugin sources in a Claude Code marketplace manifest as verified commits or pull requests.",
	"keywords": ["github-action", "claude-code", "claude-code-plugin", "marketplace-manifest"],
	"homepage": "https://github.com/spencerbeggs/claude-code-marketplace-manager#readme",
	"bugs": {
		"url": "https://github.com/spencerbeggs/claude-code-marketplace-manager/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/spencerbeggs/claude-code-marketplace-manager.git"
	},
	"license": "MIT",
	"author": "C. Spencer Beggs <spencer@beggs.codes>",
	"type": "module",
	"scripts": {
		"build": "turbo run build:prod --log-order=grouped",
		"build:prod": "github-action-builder build",
		"ci:build": "CI=\"true\" turbo run build:prod --log-order=grouped --output-logs=full",
		"ci:test": "schemastore check lib/scripts/schemastore.config.ts && CI=\"true\" vitest run --coverage",
		"lint": "biome check --max-diagnostics=none",
		"lint:fix": "biome check --write --max-diagnostics=none",
		"lint:fix:unsafe": "biome check --write --unsafe --max-diagnostics=none",
		"lint:md": "markdownlint-cli2 --config './lib/configs/.markdownlint-cli2.jsonc'",
		"lint:md:fix": "markdownlint-cli2  --config './lib/configs/.markdownlint-cli2.jsonc' --fix",
		"prepare": "husky",
		"schema:build": "schemastore build lib/scripts/schemastore.config.ts",
		"schema:check": "schemastore check lib/scripts/schemastore.config.ts",
		"test": "vitest run --pass-with-no-tests",
		"test:coverage": "vitest run --coverage --pass-with-no-tests",
		"test:watch": "vitest --watch --pass-with-no-tests",
		"typecheck": "turbo run types:check --log-prefix=none --log-order=grouped",
		"types:check": "tsc --noEmit",
		"validate": "github-action-builder validate"
	},
	"dependencies": {
		"@effect/platform-node": "catalog:effect",
		"@effected/github": "catalog:effected",
		"@effected/github-actions": "catalog:effected",
		"@effected/jsonc": "catalog:effected",
		"@effected/schemastore": "catalog:effected",
		"ajv": "^8.20.0",
		"effect": "catalog:effect"
	},
	"devDependencies": {
		"@effect/vitest": "catalog:effect",
		"@effected/schemastore-cli": "catalog:effected",
		"@effected/yaml": "catalog:effected",
		"@okfit/plugin": "^0.4.1",
		"@savvy-web/github-action-builder": "^2.4.2",
		"@savvy-web/silk": "^4.2.2",
		"@vitest-agent/plugin": "^4.1.0"
	},
	"packageManager": "pnpm@12.5.0+sha512.9cdbaa34ffacae1768635ac0d23e94db6201c7d59bf3da236b23d67c8f6b794d1dab323bcd5bcc51b55c8cafbf6f19a24e4aa61d6ab7772aa3b5cc85e325dc4d",
	"engines": {
		"node": ">=24.11.0"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "12.5.0+sha512.9cdbaa34ffacae1768635ac0d23e94db6201c7d59bf3da236b23d67c8f6b794d1dab323bcd5bcc51b55c8cafbf6f19a24e4aa61d6ab7772aa3b5cc85e325dc4d",
			"onFail": "ignore"
		},
		"runtime": [
			{
				"name": "node",
				"version": "26.9.0",
				"onFail": "ignore"
			}
		]
	}
}
