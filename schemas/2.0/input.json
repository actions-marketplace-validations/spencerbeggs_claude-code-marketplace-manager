{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$id": "https://raw.githubusercontent.com/spencerbeggs/ai-plugin-marketplace-manager/main/schemas/2.0/input.json",
	"$ref": "#/$defs/MarketplacePatchInput",
	"$defs": {
		"PluginPatch": {
			"type": "object",
			"properties": {
				"name": {
					"type": "string",
					"minLength": 1,
					"description": "Name of an existing plugin entry in the target manifest."
				},
				"marketplace": {
					"type": "string",
					"enum": ["claude-code", "copilot"],
					"description": "Which marketplace manifest the patch targets."
				},
				"sha": {
					"type": "string",
					"pattern": "^[0-9a-f]{40}$",
					"description": "New source.sha (40-hex lowercase commit)."
				},
				"path": {
					"type": "string",
					"pattern": "^[^/].*$",
					"description": "New source.path (non-empty, relative)."
				}
			},
			"required": ["name", "marketplace", "sha"],
			"additionalProperties": false
		},
		"MarketplacePatchInput": {
			"type": "object",
			"properties": {
				"plugins": {
					"type": "array",
					"minItems": 1,
					"description": "Plugin patches; at least one.",
					"items": {
						"$ref": "#/$defs/PluginPatch"
					}
				}
			},
			"required": ["plugins"],
			"additionalProperties": false
		}
	}
}
