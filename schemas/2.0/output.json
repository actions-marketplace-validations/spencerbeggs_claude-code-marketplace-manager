{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$id": "https://raw.githubusercontent.com/spencerbeggs/ai-plugin-marketplace-manager/main/schemas/2.0/output.json",
	"$ref": "#/$defs/MarketplaceManagerResult",
	"$defs": {
		"ChangedPlugin": {
			"type": "object",
			"properties": {
				"marketplace": {
					"type": "string",
					"enum": ["claude-code", "copilot"],
					"description": "Which marketplace manifest the patch targets."
				},
				"manifest": {
					"type": "string",
					"enum": [".claude-plugin/marketplace.json", ".github/plugin/marketplace.json"],
					"description": "Manifest file the entry lives in."
				},
				"name": {
					"type": "string"
				},
				"fields": {
					"type": "array",
					"items": {
						"type": "string",
						"enum": ["path", "sha"]
					}
				}
			},
			"required": ["marketplace", "manifest", "name", "fields"],
			"additionalProperties": false
		},
		"CommitInfo": {
			"type": "object",
			"properties": {
				"sha": {
					"type": "string"
				},
				"url": {
					"anyOf": [
						{
							"type": "string"
						},
						{
							"type": "null"
						}
					]
				}
			},
			"required": ["sha", "url"],
			"additionalProperties": false
		},
		"PrInfo": {
			"type": "object",
			"properties": {
				"number": {
					"type": "integer"
				},
				"url": {
					"anyOf": [
						{
							"type": "string"
						},
						{
							"type": "null"
						}
					]
				}
			},
			"required": ["number", "url"],
			"additionalProperties": false
		},
		"MarketplaceManagerResult": {
			"type": "object",
			"properties": {
				"$schema": {
					"type": "string",
					"enum": [
						"https://raw.githubusercontent.com/spencerbeggs/ai-plugin-marketplace-manager/main/schemas/2.0/output.json"
					]
				},
				"mode": {
					"type": "string",
					"enum": ["commit", "pr"]
				},
				"status": {
					"type": "string",
					"enum": ["no-op", "success", "failed"]
				},
				"noop": {
					"type": "boolean"
				},
				"succeeded": {
					"type": "boolean"
				},
				"hasFailures": {
					"type": "boolean"
				},
				"dryRun": {
					"type": "boolean"
				},
				"pluginsUpdated": {
					"type": "integer"
				},
				"plugins": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/ChangedPlugin"
					}
				},
				"manifests": {
					"type": "array",
					"description": "Manifest files the run changed (or, in dry-run, would change), in processing order.",
					"items": {
						"type": "string"
					}
				},
				"commit": {
					"anyOf": [
						{
							"$ref": "#/$defs/CommitInfo"
						},
						{
							"type": "null"
						}
					]
				},
				"pr": {
					"anyOf": [
						{
							"$ref": "#/$defs/PrInfo"
						},
						{
							"type": "null"
						}
					]
				}
			},
			"required": [
				"$schema",
				"mode",
				"status",
				"noop",
				"succeeded",
				"hasFailures",
				"dryRun",
				"pluginsUpdated",
				"plugins",
				"manifests",
				"commit",
				"pr"
			],
			"additionalProperties": false,
			"description": "Result of a marketplace-manager run. `noop` true ⇒ nothing changed and no commit/PR. `succeeded` true with `noop` false ⇒ the edit landed (or, in dry-run, would have). `status` is derived: no-op ⇒ 'no-op', else succeeded ⇒ 'success', else 'failed'."
		}
	}
}
